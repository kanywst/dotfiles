# Ghostty — synced via stow.
#
# Reference: https://ghostty.org/docs/config/reference
# Reload after edits with `cmd+shift+,` or `ghostty +show-config`.

# ---------- font ----------
# Quote font names that contain spaces to be safe across parser versions.
font-family = "Hack Nerd Font"
font-size = 13
font-feature = +liga
font-feature = +calt

# ---------- theme ----------
# Browse with `ghostty +list-themes`. Tokyo Night matches the synthwave-y
# starship/atuin palette. Follows macOS appearance; dark is the everyday look
# (system is pinned Dark).
theme = dark:tokyonight,light:TokyoNight Day

# ---------- window ----------
background-opacity = 0.96
background-blur-radius = 20
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-save-state = always
macos-titlebar-style = transparent
macos-option-as-alt = left
macos-non-native-fullscreen = true

# ---------- cursor / selection ----------
cursor-style = block
cursor-style-blink = false
copy-on-select = clipboard
mouse-hide-while-typing = true

# ---------- scrollback ----------
scrollback-limit = 100000

# ---------- shell ----------
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ---------- keybinds (splits / tabs) ----------
# Splits — Ghostty's built-in multiplexing replaces tmux/zellij for casual use.
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+enter=toggle_split_zoom

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab

# Misc
keybind = cmd+k=clear_screen
