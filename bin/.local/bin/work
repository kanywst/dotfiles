#!/usr/bin/env bash
# work — one-shot "update everything" run for the start of a work session.
#
# This machine is nix-darwin declarative (see zsh/conf.d/00-env.zsh:
# HOMEBREW_NO_AUTO_UPDATE=1, "nix-darwin owns reconciliation"). So the canonical
# system update is `nix flake update` + `darwin-rebuild switch`, NOT a bare
# `brew upgrade`. nix doesn't manage the per-user tool managers though
# (rustup / mise / npm-g / krew / gh extensions), so those are bumped here too.
#
# Runs every step unattended — no per-step confirmation. The only interactive
# point is sudo for darwin-rebuild, which is asked for up front.
#
# UI: when `gum` is present each step gets a spinner; command output is hidden
# unless the step fails (--show-error) or --verbose is passed (--show-output).
# Without gum it degrades to plain, still-readable output.
#
# Every step is capped by a watchdog (WORK_TIMEOUT, default 30m). `gum spin`
# hides a step's output, so a stalled download or an invisible prompt burns the
# whole session with nothing on screen; the cap turns that into a failed step and
# lets the rest of the run finish. Set WORK_TIMEOUT=0 to disable it. The cap needs
# timeout(1) from coreutils; without it the steps run unbounded and the run says
# so up front rather than pretending it's protected.
#
# Usage:
#   work               # update everything (pretty)
#   work -v|--verbose  # stream every command's output live
#   work -h|--help     # show this help
#
# Env:
#   WORK_TIMEOUT=<sec> # per-step watchdog (default 1800, 0 disables)
#   DARWIN_MAS=1       # let the nix-darwin switch install the masApps (fresh Mac)

set -uo pipefail   # NOT -e: one failing manager must not abort the rest.

export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

# Generous on purpose: a real nixpkgs-unstable rebuild can legitimately run for
# many minutes, so this must only fire on a genuine hang, never on slow work.
WORK_TIMEOUT="${WORK_TIMEOUT:-1800}"

# ---- palette (256-color; Ghostty is truecolor) ---------------------------
P=$'\e[38;5;212m'   # pink
G=$'\e[38;5;84m'    # green
R=$'\e[38;5;203m'   # red
D=$'\e[38;5;244m'   # dim grey
C=$'\e[38;5;117m'   # cyan
B=$'\e[1m'; X=$'\e[0m'

have() { command -v "$1" >/dev/null 2>&1; }
HAS_GUM=false; have gum && HAS_GUM=true

# Homebrew's coreutils links a GNU tool unprefixed when macOS has no command of
# that name, so `timeout` is there (macOS ships none) as well as `gtimeout`.
# Accept either, so the watchdog doesn't hinge on that linking policy.
TIMEOUT_BIN=
for c in timeout gtimeout; do have "$c" && { TIMEOUT_BIN=$c; break; }; done

# Spinner output mode: hidden-until-failure by default, live when verbose.
SPIN_FLAGS=(--show-error)

# ---- step bodies ---------------------------------------------------------
# Pure work, no decoration: gum hides their stdout, so any echo here is noise.
# Exported so `gum spin -- bash -c '<name>'` can see them in its subshell.

# nix-darwin: bump flake inputs, then apply. Replicates mise.toml's
# `darwin-switch` task. PATH and USER are propagated through sudo; HOME is
# deliberately not, so nix doesn't write root-owned files into ~/.cache/nix.
# USER + --impure are required because flake.nix resolves the config name from
# `builtins.getEnv "USER"`; without them eval falls back to "user" and the
# `.#$who` attribute (e.g. darwinConfigurations.takumaniwa) won't exist.
do_nix() {
    cd "$DOTFILES_DIR" || return 1
    nix flake update || return 1
    local path who; path=$PATH; who=$(whoami)
    # `sudo -n`: this runs inside `gum spin`, which swallows the password
    # prompt. The credential was already cached by the up-front `sudo -v`, so
    # -n succeeds here; if it has expired, -n fails fast with a visible error
    # instead of hanging on an invisible prompt.
    # DARWIN_MAS is read by the flake through getEnv just like USER, so it has to
    # survive sudo too - otherwise `DARWIN_MAS=1 work` still skips the mas apps.
    if command -v darwin-rebuild >/dev/null 2>&1; then
        sudo -n env "PATH=$path" "USER=$who" "DARWIN_MAS=${DARWIN_MAS-}" \
            darwin-rebuild switch --impure --flake ".#$who"
    else
        sudo -n env "PATH=$path" "USER=$who" "DARWIN_MAS=${DARWIN_MAS-}" \
            nix run github:LnL7/nix-darwin/master#darwin-rebuild -- switch --impure --flake ".#$who"
    fi
}

# Homebrew lives partly outside the flake (casks, trial installs). Leading
# `HOMEBREW_NO_AUTO_UPDATE=` un-sets the global opt-out for this run only so the
# catalog actually refreshes before upgrading.
#
# HOMEBREW_NO_ASK=1: ask-mode is on by default now (brew prints the upgrade plan
# and prompts "proceed? [y/n]"). That prompt runs inside `gum spin`, which hides
# stdout/stderr, so it would hang invisibly forever (same trap as the sudo one).
# This is an unattended run, so disable ask-mode and just proceed.
do_brew() {
    export HOMEBREW_NO_ASK=1   # runs in its own bash -c subshell; scope is this step.
    # shellcheck disable=SC1007  # `VAR= cmd` un-sets VAR for this command only.
    HOMEBREW_NO_AUTO_UPDATE= brew update \
        && brew upgrade \
        && brew upgrade --cask \
        && brew cleanup
}

do_rustup() { rustup update; }
do_mise()   { mise upgrade; }

# `npm update -g` stays within semver ranges, missing major bumps (ncu 16→22).
# Re-install each globally-outdated package at @latest to cross majors too.
do_npm() {
    local -a specs=()
    while IFS= read -r name; do
        [[ -n "$name" ]] && specs+=("${name}@latest")
    done < <(npm outdated -g --parseable --depth=0 2>/dev/null \
                | awk -F: '{print $4}' | sed 's/@[^@]*$//')
    ((${#specs[@]} == 0)) && return 0
    npm install -g "${specs[@]}"
}

do_krew()  { kubectl krew upgrade; }
do_gh()    { gh extension upgrade --all; }
do_atuin() { atuin sync -f; }
export -f do_nix do_brew do_rustup do_mise do_npm do_krew do_gh do_atuin

# ---- guards: is this step applicable on this machine? --------------------
# nix-darwin also needs sudo. If the up-front `sudo -v` failed (SUDO_OK=false),
# return false here so the step is cleanly skipped — otherwise darwin-rebuild's
# own sudo prompt gets buried inside the gum spinner and the run hangs forever.
g_nix()    { have nix && [[ "$SUDO_OK" == true ]]; }
g_brew()   { have brew; }
g_rustup() { have rustup; }
g_mise()   { have mise; }
g_npm()    { have npm; }
g_krew()   { have kubectl && kubectl krew version >/dev/null 2>&1; }
g_gh()     { have gh; }
g_atuin()  { have atuin; }

# ---- orchestration -------------------------------------------------------
declare -a DONE=() FAILED=() SKIPPED=()
IDX=0
TOTAL=8
SUDO_OK=true   # flipped to false below if the up-front `sudo -v` fails.

# step <emoji> <label> <spinner> <fn> <guard>
step() {
    local emoji="$1" label="$2" spin="$3" fn="$4" guard="$5" reason="${6:-not installed}"
    IDX=$((IDX + 1))
    local tag; tag=$(printf '[%d/%d]' "$IDX" "$TOTAL")

    if ! "$guard"; then
        printf '%s  %s %s %s — skipped (%s)%s\n' \
            "$D" "$tag" "$emoji" "$label" "$reason" "$X"
        SKIPPED+=("$label"); return
    fi

    # Deliberately NOT --foreground: that flag skips putting the command in its
    # own process group, so on expiry only the direct `bash -c` is signalled and
    # the actual worker (darwin-rebuild, brew bundle, mas install) is orphaned and
    # keeps running. Verified: with --foreground a grandchild survives the kill,
    # without it the whole group dies. The steps here never read the TTY (sudo is
    # pre-warmed, HOMEBREW_NO_ASK=1), so the group has nothing to lose by it.
    # Caveat: `do_nix` does its work through `sudo`, and a user-owned timeout
    # can't signal a root process - that step still ends at 124 and frees the run,
    # but the root child has to be reaped by hand.
    local -a runner=(bash -c "set -uo pipefail; $fn")
    local wrapped=false
    if ((WORK_TIMEOUT > 0)) && [[ -n "$TIMEOUT_BIN" ]]; then
        runner=("$TIMEOUT_BIN" "$WORK_TIMEOUT" "${runner[@]}")
        wrapped=true
    fi

    local t0=$SECONDS rc
    if $HAS_GUM; then
        gum spin --spinner "$spin" \
            --spinner.foreground 212 --title.foreground 252 \
            --title "  $tag  $emoji  ${label}…" \
            "${SPIN_FLAGS[@]}" -- "${runner[@]}"
        rc=$?
    else
        printf '%s▸ %s %s %s…%s\n' "$C" "$tag" "$emoji" "$label" "$X"
        "${runner[@]}"; rc=$?
    fi
    local dt=$((SECONDS - t0))

    if ((rc == 0)); then
        printf '%s  ✓%s %s %s %s%s(%ds)%s\n' "$G" "$X" "$emoji" "$label" "$D" "$D" "$dt" "$X"
        DONE+=("$label")
    elif $wrapped && ((rc == 124)); then
        # 124 only means "watchdog fired" when the watchdog was actually in play;
        # unwrapped it's just the step's own exit status.
        printf '%s  ✗ %s %s timed out%s %s(%ds — WORK_TIMEOUT=%ss)%s\n' \
            "$R" "$emoji" "$label" "$X" "$D" "$dt" "$WORK_TIMEOUT" "$X"
        FAILED+=("$label")
    else
        printf '%s  ✗ %s %s failed%s %s(%ds — output above)%s\n' "$R" "$emoji" "$label" "$X" "$D" "$dt" "$X"
        FAILED+=("$label")
    fi
}

banner() {
    if $HAS_GUM; then
        gum style --border double --border-foreground 212 \
            --foreground 213 --bold --align center \
            --padding "1 6" --margin "1 0" --width 48 \
            "⚡  W O R K  ⚡" "" "let's get you up to date"
        printf '%s   %s · %s%s\n' "$D" "$(hostname -s)" "$(date '+%a %d %b %H:%M')" "$X"
    else
        printf '\n%s%s⚡ work%s — %s · %s\n\n' "$B" "$P" "$X" "$(hostname -s)" "$(date '+%a %d %b %H:%M')"
    fi
}

summary() {
    local elapsed=$1
    local dn="${DONE[*]:-—}"  sk="${SKIPPED[*]:-—}"  fl="${FAILED[*]:-—}"
    local counts; counts=$(printf '✅ %d updated   💤 %d skipped   ❌ %d failed' \
        "${#DONE[@]}" "${#SKIPPED[@]}" "${#FAILED[@]}")

    local head color=84
    if ((${#FAILED[@]})); then head="💥  finished with errors  ·  ${elapsed}s"; color=203
    else                       head="🎉  all done  ·  ${elapsed}s"; fi

    if $HAS_GUM; then
        gum style --border rounded --border-foreground "$color" \
            --padding "1 3" --margin "1 0" \
            "$head" "" "$counts" \
            "${C}updated${X}  $dn" \
            "${D}skipped  $sk${X}" \
            "${R}failed   $fl${X}"
    else
        printf '\n%s── %s ──%s\n%s\n' "$P" "$head" "$X" "$counts"
        printf '  updated: %s\n  skipped: %s\n  failed:  %s\n' "$dn" "$sk" "$fl"
    fi

    # Footnote: tools with no clean bulk-update path — flagged so it's obvious
    # they're intentionally untouched, not forgotten.
    printf '%s  · cargo/go bins are not auto-updated (no bulk updater here)%s\n' "$D" "$X"
}

# ---- main ----------------------------------------------------------------
while (($#)); do
    case "$1" in
        -h|--help)
            # Print the contiguous comment block (skip the shebang, stop at the
            # first non-comment line), stripping the leading "# ".
            awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
            exit 0 ;;
        -v|--verbose) SPIN_FLAGS=(--show-output); shift ;;
        *) printf '%sunknown argument: %s%s\ntry: work --help\n' "$R" "$1" "$X" >&2; exit 2 ;;
    esac
done

banner
start=$SECONDS

# Say so out loud rather than degrading quietly: a run with no watchdog is
# exactly the run that can burn an hour behind the spinner.
if ((WORK_TIMEOUT > 0)) && [[ -z "$TIMEOUT_BIN" ]]; then
    printf '%s  ⚠️  no timeout(1)/gtimeout from coreutils — steps run unbounded this time.%s\n' "$R" "$X"
fi

printf '%s  🔐 warming sudo (needed for the nix-darwin switch)…%s\n' "$D" "$X"
# Prompt once, up front, instead of mid-run. If this fails (wrong password,
# no sudo rights), DON'T plough ahead: every sudo inside a step runs under
# `gum spin`, which hides stdout/stderr, so a second prompt would be invisible
# and the run would hang on it forever (the "3156s" hang). Record the failure
# and let g_nix skip nix-darwin cleanly while the non-sudo managers still run.
if ! sudo -v; then
    SUDO_OK=false
    printf '%s  ⚠️  sudo not authorized — skipping nix-darwin, running the rest.%s\n' "$R" "$X"
fi
echo

step "❄️"  "nix-darwin"    globe   do_nix    g_nix    "needs nix + sudo"
step "🍺"  "homebrew"      meter   do_brew   g_brew
step "🦀"  "rustup"        monkey  do_rustup g_rustup
step "🧰"  "mise"          minidot do_mise   g_mise
step "📦"  "npm globals"   line    do_npm    g_npm
step "☸️"  "krew"          points  do_krew   g_krew
step "🐙"  "gh extensions" pulse   do_gh     g_gh
step "🐢"  "atuin"         moon    do_atuin  g_atuin

# catch TOTAL drifting from the number of step calls above.
((IDX == TOTAL)) || printf '%s  ⚠️  step count %d != TOTAL %d%s\n' \
    "$R" "$IDX" "$TOTAL" "$X" >&2

summary $((SECONDS - start))
((${#FAILED[@]} == 0))
