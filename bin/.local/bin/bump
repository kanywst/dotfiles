#!/usr/bin/env bash
# bump — one-shot "update everything" run for the start of a work session.
#
# This machine is nix-darwin declarative (see zsh/conf.d/00-env.zsh:
# HOMEBREW_NO_AUTO_UPDATE=1, "nix-darwin owns reconciliation"). So the canonical
# system update is `nix flake update` + `darwin-rebuild switch`, NOT a bare
# `brew upgrade`. nix doesn't manage the per-user tool managers though
# (rustup / mise / npm-g / krew / gh extensions / cargo / go), so those are
# bumped here too.
#
# Runs every step unattended — no per-step confirmation. The only interactive
# point is sudo, which is asked for up front and then kept warm for the whole
# run (darwin-rebuild needs it immediately; a Pkg cask upgrade needs it ~25
# minutes in, long after the 5-minute sudo timestamp would have lapsed). sudo is
# only requested when a selected step actually needs it, so e.g. `bump --only
# npm` never prompts.
#
# Steps run in two phases. The serial phase (nix flake → nix-darwin → brew →
# brew casks) is ordered and root-hungry. Everything after it is independent, so
# it runs concurrently and each result prints the moment that tool finishes.
#
# UI: when `gum` is present each serial step gets a spinner. Every step's output
# is captured to a per-run log directory instead of the screen; a failing step
# has its log tail printed inline, and the run prints the log directory at the
# end. `--verbose` skips the spinners, streams output live, and forces every
# step serial so concurrent output can't interleave into noise.
#
# Every step is capped by a watchdog (BUMP_TIMEOUT, default 30m). Output is
# hidden by default, so a stalled download or an invisible prompt would burn the
# whole session with nothing on screen; the cap turns that into a failed step and
# lets the rest of the run finish. Set BUMP_TIMEOUT=0 to disable it. The cap needs
# timeout(1) from coreutils; without it the steps run unbounded and the run says
# so up front rather than pretending it's protected.
#
# Usage:
#   bump                    # update everything (pretty)
#   bump -n|--dry-run       # show the plan and what would be skipped, run nothing
#   bump --only nix,brew    # run only these steps (comma-separated)
#   bump --skip atuin,npm   # run everything except these
#   bump -l|--list          # list the step names
#   bump -v|--verbose       # stream every command's output live, serially
#   bump -V|--version       # print the version and the revision it came from
#   bump -h|--help          # show this help
#
# Env:
#   BUMP_TIMEOUT=<sec> # per-step watchdog (default 1800, 0 disables)
#   DOTFILES_DIR=<dir> # dotfiles checkout the nix steps operate on (~/dotfiles)
#   DARWIN_MAS=1       # let the nix-darwin switch install the masApps (fresh Mac)

set -uo pipefail   # NOT -e: one failing manager must not abort the rest.

# Bumped by hand; the tag `bump-v<this>` marks the commit it was bumped in.
# It exists so a screenshot of a run can be traced to a revision. That came up
# for real: a bug report arrived as an image and the only way to tell which
# version produced it was to squint at the shape of the summary box.
BUMP_VERSION=1.0.0

export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

# Generous on purpose: a real nixpkgs-unstable rebuild can legitimately run for
# many minutes, so this must only fire on a genuine hang, never on slow work.
BUMP_TIMEOUT="${BUMP_TIMEOUT:-1800}"

LOG_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/bump"
# The pid is part of the name, not decoration: the timestamp has one-second
# resolution, so two runs started in the same second shared a directory — and
# the parallel phase finds a step's sentinel from the PREVIOUS run already
# sitting there and reports its result instead of running its own. Found by the
# test suite, which starts runs back to back.
LOG_DIR="$LOG_ROOT/$(date +%Y%m%d-%H%M%S)-$$"

# ---- palette (256-color; Ghostty is truecolor) ---------------------------
P=$'\e[38;5;212m'   # pink
G=$'\e[38;5;84m'    # green
R=$'\e[38;5;203m'   # red
D=$'\e[38;5;244m'   # dim grey
C=$'\e[38;5;117m'   # cyan
B=$'\e[1m'; X=$'\e[0m'

have() { command -v "$1" >/dev/null 2>&1; }
HAS_GUM=false; have gum && HAS_GUM=true

# Homebrew's coreutils links a GNU tool unprefixed when macOS has no command of
# that name, so `timeout` is there (macOS ships none) as well as `gtimeout`.
# Accept either, so the watchdog doesn't hinge on that linking policy.
TIMEOUT_BIN=
for c in timeout gtimeout; do have "$c" && { TIMEOUT_BIN=$c; break; }; done

# ---- the step table ------------------------------------------------------
# name|emoji|label|spinner|phase|sudo
#   phase  serial = order matters and/or it needs root; par = independent.
#   sudo   yes    = skipped outright when the up-front `sudo -v` didn't take.
# The list is the single source of truth: step count, --only/--skip names and
# run order all derive from it, so adding a tool here is the whole change.
STEPS=(
    "flake|❄️|nix flake inputs|globe|serial|no"
    "darwin|🍎|nix-darwin switch|globe|serial|yes"
    "brew|🍺|homebrew formulae|meter|serial|no"
    "brew-cask|🍻|homebrew casks|meter|serial|yes"
    "rustup|🦀|rustup|monkey|par|no"
    "mise|🧰|mise|minidot|par|no"
    "npm|📦|npm globals|line|par|no"
    "krew|☸️|krew|points|par|no"
    "gh|🐙|gh extensions|pulse|par|no"
    "atuin|🐢|atuin sync|moon|par|no"
    "cargo|🦞|cargo bins|dot|par|no"
    "gup|🐹|go bins|dot|par|no"
)

# ---- step bodies ---------------------------------------------------------
# Pure work, no decoration: their stdout is redirected to a per-step log, so any
# echo here is for the log, not the screen. Exported so the `bash -c` each step
# runs in can see them.

do_flake() { cd "$DOTFILES_DIR" && nix flake update; }

# nix-darwin: apply the flake. The one implementation — mise.toml's
# `darwin-switch` task delegates here rather than keeping a second copy.
# PATH and USER are propagated through sudo; HOME is deliberately not, so nix
# doesn't write root-owned files into ~/.cache/nix. USER + --impure are required
# because flake.nix resolves the config name from `builtins.getEnv "USER"`;
# without them eval falls back to "user" and the `.#$who` attribute (e.g.
# darwinConfigurations.takumaniwa) won't exist.
do_darwin() {
    cd "$DOTFILES_DIR" || return 1
    local path who; path=$PATH; who=$(whoami)
    # `sudo -n`: this can run inside `gum spin`, which swallows the password
    # prompt. The credential was already cached by the up-front `sudo -v`, so
    # -n succeeds here; if it has expired, -n fails fast with a visible error
    # instead of hanging on an invisible prompt.
    # DARWIN_MAS is read by the flake through getEnv just like USER, so it has to
    # survive sudo too - otherwise `DARWIN_MAS=1 bump` still skips the mas apps.
    if command -v darwin-rebuild >/dev/null 2>&1; then
        sudo -n env "PATH=$path" "USER=$who" "DARWIN_MAS=${DARWIN_MAS-}" \
            darwin-rebuild switch --impure --flake ".#$who"
    else
        sudo -n env "PATH=$path" "USER=$who" "DARWIN_MAS=${DARWIN_MAS-}" \
            nix run github:LnL7/nix-darwin/master#darwin-rebuild -- switch --impure --flake ".#$who"
    fi
}

# Homebrew lives partly outside the flake (casks, trial installs). Leading
# `HOMEBREW_NO_AUTO_UPDATE=` un-sets the global opt-out for this run only so the
# catalog actually refreshes before upgrading.
#
# HOMEBREW_NO_ASK=1: ask-mode is on by default now (brew prints the upgrade plan
# and prompts "proceed? [y/n]"). That prompt can run inside `gum spin`, which
# hides stdout/stderr, so it would hang invisibly forever (same trap as the sudo
# one). This is an unattended run, so disable ask-mode and just proceed.
do_brew() {
    export HOMEBREW_NO_ASK=1   # runs in its own bash -c subshell; scope is this step.
    # shellcheck disable=SC1007  # `VAR= cmd` un-sets VAR for this command only.
    HOMEBREW_NO_AUTO_UPDATE= brew update \
        && brew upgrade \
        && brew cleanup
}

# Casks are their own step because they are the part that needs root mid-run: a
# Pkg-artifact cask (multipass) shells out to `sudo launchctl`/`pkgutil` to tear
# the old service down. Folded into do_brew it was unguarded — with no sudo
# grant it sat on an invisible password prompt behind the spinner until the
# watchdog killed it 30 minutes later. As its own sudo:yes step it is skipped
# cleanly instead, and the formula upgrades still run.
do_brew_cask() {
    export HOMEBREW_NO_ASK=1
    brew upgrade --cask
}

do_rustup() { rustup update; }
do_mise()   { mise upgrade; }

# `npm update -g` stays within semver ranges, missing major bumps (ncu 16→22).
# Re-install each globally-outdated package at @latest to cross majors too.
do_npm() {
    local out rc
    out=$(npm outdated -g --parseable --depth=0); rc=$?
    # `npm outdated` exits 1 when something IS outdated, so only >1 is a real
    # failure. This used to be `2>/dev/null` with the status dropped, which made
    # a broken npm indistinguishable from "nothing to do" and reported ✓.
    ((rc > 1)) && return "$rc"
    local -a specs=()
    local name
    # --parseable is path:name@wanted:name@current:name@latest — field 4 carries
    # the name, and `@[^@]*$` strips only the version, leaving @scope/name whole.
    while IFS= read -r name; do
        [[ -n "$name" ]] && specs+=("${name}@latest")
    done < <(printf '%s\n' "$out" | awk -F: 'NF > 1 {print $4}' | sed 's/@[^@]*$//')
    ((${#specs[@]} == 0)) && { echo "nothing outdated"; return 0; }
    npm install -g "${specs[@]}"
}

do_krew()  { kubectl krew upgrade; }
do_gh()    { gh extension upgrade --all; }
do_atuin() { atuin sync -f; }
do_cargo() { cargo install-update -a; }
do_gup()   { gup update; }
export -f do_flake do_darwin do_brew do_brew_cask do_rustup do_mise do_npm \
          do_krew do_gh do_atuin do_cargo do_gup

# ---- guards: is this step applicable on this machine? --------------------
# Each sets SKIP_REASON before returning false, so a skip line says which of
# "not installed" / "not configured" it actually is. Reporting "not installed"
# for a tool that is installed but unusable (atuin without a login) hid a step
# that failed on every single run.
# The multi-line guards below must write `|| { _missing x; return 1; }` and not
# a bare `|| _missing x`: a helper cannot return for its caller, so the bare
# form set the reason and then fell through to the next check. That is how
# `rustup` ran — and failed with exit 127 — on a machine with no rustup at all.
SKIP_REASON=
_missing() { SKIP_REASON="$1 not installed"; return 1; }

# Both nix steps operate on $DOTFILES_DIR's flake, so a nix binary alone is not
# enough: pointed at a checkout without one (or at nothing, on a machine where
# the dotfiles live elsewhere) they failed on every run with nix's own error.
_has_flake() {
    have nix || { _missing nix; return 1; }
    [[ -f "$DOTFILES_DIR/flake.nix" ]] || {
        SKIP_REASON="no flake.nix in $DOTFILES_DIR"; return 1; }
}
g_flake()  { _has_flake; }
g_darwin() { _has_flake; }
g_brew()   { have brew || _missing brew; }
g_brew_cask() { have brew || _missing brew; }
g_mise()   { have mise || _missing mise; }
g_npm()    { have npm || _missing npm; }
g_gh()     { have gh || _missing gh; }
g_cargo()  { have cargo-install-update || _missing "cargo-install-update (cargo install cargo-update)"; }
g_gup()    { have gup || _missing "gup (go install github.com/nao1215/gup@latest)"; }

# A rustup shim can exist with no toolchains behind it (rust installed through
# mise or nix), where `rustup update` just errors every run.
g_rustup() {
    have rustup || { _missing rustup; return 1; }
    [[ -d "${RUSTUP_HOME:-$HOME/.rustup}/toolchains" ]] || {
        SKIP_REASON="no rustup toolchains"; return 1; }
}

g_krew() {
    have kubectl || { _missing kubectl; return 1; }
    kubectl krew version >/dev/null 2>&1 || { SKIP_REASON="krew plugin not installed"; return 1; }
}

# Presence only, deliberately. This briefly also required a session file at
# ${XDG_DATA_HOME}/atuin/session on the theory that a logged-out atuin fails
# every run — but an Atuin Hub login does not write that file, so the check
# skipped a step that was working: on this machine there is no session file,
# `atuin login` reports "You are authenticated with Atuin Hub", and
# `atuin sync -f` returns 0 and uploads. A missing file I expected is not
# proof of a missing login. If atuin really is logged out, the step fails and
# its log tail now says so, which is the visibility that was actually wanted.
g_atuin() { have atuin || _missing atuin; }

# ---- plan ----------------------------------------------------------------
declare -a DONE=() DONE_SECS=() FAILED=() SKIPPED=()
declare -a SEL_NAME=() SEL_EMOJI=() SEL_LABEL=() SEL_SPIN=() SEL_PHASE=() SEL_SUDO=()
SUDO_OK=true       # flipped to false below if the up-front `sudo -v` fails.
SUDO_NEEDED=false  # only prompt when a selected step actually wants root.
VERBOSE=false
DRY_RUN=false
ONLY=
SKIP=

all_names() {
    local rec
    for rec in "${STEPS[@]}"; do printf '%s\n' "${rec%%|*}"; done
}

# Comma-separated list membership, exact string match.
# `set -f` around the split because splitting `$list` on IFS also globs it, so
# `--skip '*'` would expand against the files in $PWD before anything compared.
in_list() {
    local needle="$1" list="$2" item rc=1
    local IFS=','
    set -f
    for item in $list; do [[ "$item" == "$needle" ]] && { rc=0; break; }; done
    set +f
    return $rc
}

# A typo in --only used to silently run nothing at all; name it and exit 2.
# Matching is literal (`grep -F -x`): as a regex, `--only '.*'` would validate
# against every step name and then select none.
validate_names() {
    local flag="$1" list="$2" item known
    known=$(all_names)
    local IFS=','
    set -f
    for item in $list; do
        [[ -n "$item" ]] || continue
        grep -qxF -- "$item" <<<"$known" || {
            set +f
            printf '%sunknown step in %s: %s%s\nknown steps: %s\n' \
                "$R" "$flag" "$item" "$X" "$(all_names | paste -sd, -)" >&2
            exit 2
        }
    done
    set +f
}

build_plan() {
    local rec name emoji label spin phase sudo
    for rec in "${STEPS[@]}"; do
        IFS='|' read -r name emoji label spin phase sudo <<<"$rec"
        [[ -n "$ONLY" ]] && ! in_list "$name" "$ONLY" && continue
        [[ -n "$SKIP" ]] &&   in_list "$name" "$SKIP" && continue
        SEL_NAME+=("$name"); SEL_EMOJI+=("$emoji"); SEL_LABEL+=("$label")
        SEL_SPIN+=("$spin"); SEL_PHASE+=("$phase"); SEL_SUDO+=("$sudo")
        [[ "$sudo" == yes ]] && SUDO_NEEDED=true
    done
    return 0   # else the loop's last `[[ ]] &&` decides this function's status
}

# ---- running a step ------------------------------------------------------
# Deliberately NOT --foreground: that flag skips putting the command in its own
# process group, so on expiry only the direct `bash -c` is signalled and the
# actual worker (darwin-rebuild, brew bundle, mas install) is orphaned and keeps
# running. Verified: with --foreground a grandchild survives the kill, without it
# the whole group dies. The steps here never read the TTY (sudo is pre-warmed,
# HOMEBREW_NO_ASK=1), so the group has nothing to lose by it.
# Caveat: `do_darwin` does its work through `sudo`, and a user-owned timeout
# can't signal a root process - that step still ends at 124 and frees the run,
# but the root child has to be reaped by hand.
RUNNER=()
build_runner() {
    local fn="do_${1//-/_}" inner
    # The runner catches TERM so that `timeout -k` can do its job at all: timeout
    # returns as soon as its DIRECT child exits, and this shell is that child, so
    # without the trap it died on the watchdog's TERM in milliseconds, timeout
    # returned, and the kill-after never fired — measured, a step that ignored
    # TERM was reported as timed out while its process went on running as an
    # orphan, still alive 38s later.
    #
    # `trap ':'` and not `trap ''`: an IGNORED signal is inherited across exec,
    # so `trap ''` made every child ignore TERM too and an ordinary step then sat
    # out the whole 30s kill-after for nothing (32s for a step that should have
    # died in 2). A CAUGHT signal is reset to the default in the exec'd child, so
    # only this shell survives and the steps themselves still die on TERM.
    #
    # Both branches run $fn as a plain foreground command, verbose included.
    # `$fn | tee` looks equivalent and is not: with the step on the left of a
    # pipeline, the runner's wait is interrupted by the caught TERM and does not
    # resume, so it returned in 2s where the same step took the full 32s to be
    # SIGKILLed on the non-verbose path — measured side by side on one serial
    # step. Redirecting into a process substitution keeps tee without putting
    # the step in a pipeline, and makes $fn's own status the runner's status
    # instead of leaning on pipefail.
    local guard="trap ':' TERM; "
    if $VERBOSE; then
        inner="${guard}set -uo pipefail; exec > >(tee \"\$BUMP_LOG\") 2>&1; $fn"
    else
        inner="${guard}set -uo pipefail; exec >\"\$BUMP_LOG\" 2>&1; $fn"
    fi
    RUNNER=(bash -c "$inner")
    if ((BUMP_TIMEOUT > 0)) && [[ -n "$TIMEOUT_BIN" ]]; then
        # -k 30: the watchdog's TERM is only a request. A package manager that
        # traps it (or is mid-`brew` Ruby teardown) would keep the whole process
        # group alive past its own timeout, which is the hang the watchdog exists
        # to end. SIGKILL 30s later closes that — but only together with the
        # runner's TERM trap above; on its own this flag was a no-op.
        RUNNER=("$TIMEOUT_BIN" -k 30 "$BUMP_TIMEOUT" "${RUNNER[@]}")
    fi
}

tag() { printf '%-*s' "$TAG_W" "$(printf '[%d/%d]' "$1" "${#SEL_NAME[@]}")"; }

# `gum spin` ends by asking the terminal whether it supports synchronized output
# and grapheme clustering — DECRQM `\e[?2026$p` and `\e[?2027$p`, verifiably the
# last bytes it writes — and then exits without reading the answers. The terminal
# replies `\e[?2026;2$y` on the tty INPUT queue, where nothing consumes it, so
# the replies pile up and the shell reads the whole pile as typed input the
# moment the run ends: a prompt full of `2026;2$y2027;2$y…`, one pair per
# spinner step. Redirecting gum's stdin does not help — the reply goes to the
# terminal, not to gum's fd 0 — so the only fix is to drain the tty ourselves.
#
# `stty min 0 time 0` makes the read return whatever is buffered instead of
# blocking. That form is used rather than `read -t 0.05` because bash 3.2's
# `read -t` takes whole seconds only, and a 1s stall per step is worse than the
# bug. TTIN/TTOU are ignored across it so that running bump in the background
# fails these calls instead of stopping the process on a terminal-access signal.
drain_tty() {
    # Probe by opening it, not with `[[ -e /dev/tty ]]`: the device node exists
    # even for a process with no controlling terminal, where every `</dev/tty`
    # below then fails — and a failed redirection is reported by bash itself,
    # which no `2>/dev/null` on the command can suppress.
    { : </dev/tty; } 2>/dev/null || return 0
    local saved
    trap '' TTIN TTOU
    saved=$(stty -g </dev/tty 2>/dev/null)
    if [[ -n "$saved" ]]; then
        stty -icanon min 0 time 0 </dev/tty 2>/dev/null
        dd bs=4096 count=1 </dev/tty >/dev/null 2>&1
        stty "$saved" </dev/tty 2>/dev/null
    fi
    trap - TTIN TTOU
    return 0
}

say_skip() { # idx emoji label reason
    printf '%s  %s %s %s — skipped (%s)%s\n' "$D" "$(tag "$1")" "$2" "$3" "$4" "$X"
    SKIPPED+=("$3")
}

# rc==124 only means "watchdog fired" when the watchdog was actually in play;
# unwrapped it is just the step's own exit status.
say_result() { # idx emoji label rc secs log
    local idx="$1" emoji="$2" label="$3" rc="$4" dt="$5" log="$6" t
    # The parallel phase has no spinner title to carry the tag and reports out
    # of order, so the tag has to be on the result line itself.
    t=$(tag "$idx")
    if ((rc == 0)); then
        printf '%s  ✓%s %s %s %-19s%s(%ds)%s\n' "$G" "$X" "$t" "$emoji" "$label" "$D" "$dt" "$X"
        DONE+=("$label"); DONE_SECS+=("$dt"); return
    fi
    FAILED+=("$label")
    if ((BUMP_TIMEOUT > 0)) && [[ -n "$TIMEOUT_BIN" ]] && ((rc == 124)); then
        printf '%s  ✗ %s %s %s timed out%s %s(%ds — BUMP_TIMEOUT=%ss)%s\n' \
            "$R" "$t" "$emoji" "$label" "$X" "$D" "$dt" "$BUMP_TIMEOUT" "$X"
    # 137 is SIGKILL, and past the watchdog's window that is the kill-after
    # landing on a step that sat through its SIGTERM. Reporting it as a plain
    # "failed (exit 137)" hides that the watchdog is what ended it.
    elif ((BUMP_TIMEOUT > 0)) && [[ -n "$TIMEOUT_BIN" ]] && ((rc == 137)) && ((dt >= BUMP_TIMEOUT)); then
        printf '%s  ✗ %s %s %s killed%s %s(%ds — ignored the %ss timeout, SIGKILLed)%s\n' \
            "$R" "$t" "$emoji" "$label" "$X" "$D" "$dt" "$BUMP_TIMEOUT" "$X"
    else
        printf '%s  ✗ %s %s %s failed%s %s(%ds — exit %d)%s\n' \
            "$R" "$t" "$emoji" "$label" "$X" "$D" "$dt" "$rc" "$X"
    fi
    log_tail "$log"
}

# A step whose sentinel never arrived. Reported apart from a normal failure
# because the exit status and the duration are this loop's guesses, not the
# step's own — saying "exit 137, 62s" as if the step reported that would be a
# lie about the one case where we know the least.
say_lost() { # idx emoji label secs log
    printf '%s  ✗ %s %s %s — no result after %ds (child died before reporting)%s\n' \
        "$R" "$(tag "$1")" "$2" "$3" "$4" "$X"
    FAILED+=("$3")
    log_tail "$5"
}

# The log is the only copy of the output outside verbose mode, so show the tail
# right here instead of making the reader go find it.
log_tail() {
    if ! $VERBOSE && [[ -s "$1" ]]; then
        printf '%s' "$D"
        tail -n 30 "$1" | sed 's/^/      /'
        printf '%s' "$X"
    fi
}

# Returns 1 when the step was skipped, so callers can stop there.
check_step() { # idx name emoji label sudo
    local idx="$1" name="$2" emoji="$3" label="$4" sudo="$5"
    if [[ "$sudo" == yes && "$SUDO_OK" != true ]]; then
        say_skip "$idx" "$emoji" "$label" "needs sudo"; return 1
    fi
    SKIP_REASON="not applicable"
    if ! "g_${name//-/_}"; then
        say_skip "$idx" "$emoji" "$label" "$SKIP_REASON"; return 1
    fi
    return 0
}

run_serial() { # idx name emoji label spin
    local idx="$1" name="$2" emoji="$3" label="$4" spin="$5"
    local log="$LOG_DIR/$name.log" t0=$SECONDS rc
    build_runner "$name"
    if $HAS_GUM && ! $VERBOSE; then
        BUMP_LOG="$log" gum spin --spinner "$spin" \
            --spinner.foreground 212 --title.foreground 252 \
            --title "  $(tag "$idx")  $emoji  ${label}…" -- "${RUNNER[@]}"
        rc=$?
        drain_tty
    else
        printf '%s▸ %s %s %s…%s\n' "$C" "$(tag "$idx")" "$emoji" "$label" "$X"
        BUMP_LOG="$log" "${RUNNER[@]}"; rc=$?
    fi
    say_result "$idx" "$emoji" "$label" "$rc" $((SECONDS - t0)) "$log"
}

# The independent managers, concurrently. Each child writes "<rc> <secs>" to a
# sentinel file as its last act; the parent polls for those rather than for the
# pid, because a finished-but-unreaped child still answers `kill -0` and the
# poll would never end. Results print in completion order, which is also the
# only live feedback this phase has — there is no spinner over a group.
run_parallel() { # idx... passed as parallel arrays via globals below
    local -a p_idx=() p_name=() p_emoji=() p_label=()
    local i n
    for i in "${PAR_IDX[@]}"; do
        n="${SEL_NAME[$i]}"
        check_step "$((i + 1))" "$n" "${SEL_EMOJI[$i]}" "${SEL_LABEL[$i]}" "${SEL_SUDO[$i]}" || continue
        p_idx+=("$((i + 1))"); p_name+=("$n")
        p_emoji+=("${SEL_EMOJI[$i]}"); p_label+=("${SEL_LABEL[$i]}")
    done
    ((${#p_name[@]} == 0)) && return 0

    printf '%s▸ %d in parallel: %s%s\n' "$C" "${#p_name[@]}" "$(join_with ', ' "${p_label[@]}")" "$X"

    local name log t_phase=$SECONDS
    local -a pids=()
    for i in "${!p_name[@]}"; do
        name="${p_name[$i]}"; log="$LOG_DIR/$name.log"
        rm -f "$LOG_DIR/$name.rc" "$LOG_DIR/$name.rc.part"   # never poll a stale one
        build_runner "$name"
        (
            t0=$SECONDS
            BUMP_LOG="$log" "${RUNNER[@]}"
            rc=$?
            # Write-then-rename: a plain `> $name.rc` is visible to the poller
            # the instant it is created, so it can be read back empty, and an
            # empty rc evaluates as 0 in `((rc == 0))` — a crashed step would
            # report a green tick. rename(2) makes the file appear complete.
            # Silent on failure: if the sentinel cannot be written the deadline
            # below is what reports the step, and bash's redirect error would
            # otherwise land in the middle of the results.
            { printf '%d %d\n' "$rc" "$((SECONDS - t0))" >"$LOG_DIR/$name.rc.part"; } 2>/dev/null \
                && mv -f "$LOG_DIR/$name.rc.part" "$LOG_DIR/$name.rc" 2>/dev/null
        ) &
        pids+=($!)
    done

    # A child that is SIGKILLed never writes its sentinel, and polling `kill -0`
    # instead would not help: an exited-but-unreaped child is a zombie and still
    # answers it. So bound the wait. No step can legitimately outlive its own
    # watchdog, so BUMP_TIMEOUT plus a minute of slack is a safe ceiling; with
    # the watchdog disabled the user has opted out of bounds and we wait.
    local remaining=${#p_name[@]} rc dt deadline=0
    if ((BUMP_TIMEOUT > 0)) && [[ -n "$TIMEOUT_BIN" ]]; then
        deadline=$((SECONDS + BUMP_TIMEOUT + 60))
    fi
    local -a reported=()
    for i in "${!p_name[@]}"; do reported[i]=0; done
    while ((remaining > 0)); do
        for i in "${!p_name[@]}"; do
            ((reported[i])) && continue
            [[ -f "$LOG_DIR/${p_name[$i]}.rc" ]] || continue
            rc=; dt=
            read -r rc dt <"$LOG_DIR/${p_name[$i]}.rc"
            # Belt to the rename's braces: never let a non-numeric rc through.
            [[ "$rc" =~ ^[0-9]+$ && "$dt" =~ ^[0-9]+$ ]] || continue
            say_result "${p_idx[$i]}" "${p_emoji[$i]}" "${p_label[$i]}" \
                "$rc" "$dt" "$LOG_DIR/${p_name[$i]}.log"
            reported[i]=1; remaining=$((remaining - 1))
        done
        ((remaining == 0)) && break
        if ((deadline > 0 && SECONDS > deadline)); then
            for i in "${!p_name[@]}"; do
                ((reported[i])) && continue
                # The subshell is all that can still be alive: each worker is
                # wrapped in `timeout -k 30 $BUMP_TIMEOUT`, so it is dead by
                # BUMP_TIMEOUT+30 — a full 30s before this deadline at +60.
                kill "${pids[$i]}" 2>/dev/null
                say_lost "${p_idx[$i]}" "${p_emoji[$i]}" "${p_label[$i]}" \
                    $((SECONDS - t_phase)) "$LOG_DIR/${p_name[$i]}.log"
                reported[i]=1
            done
            break
        fi
        sleep 0.2
    done
    # Reap by pid, never a bare `wait`: the sudo keep-alive is also a child of
    # this shell and it loops until the run ends, so a bare `wait` here hangs
    # the whole run forever right after the last step reports.
    local pid
    for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null; done
}

# Comma-joined, not space-joined: labels contain spaces ("npm globals", "gh
# extensions"), so a space-joined summary line gives no way to count them.
join_with() { # sep item...
    local sep="$1"; shift
    (($# == 0)) && { printf '—'; return; }
    local out="$1"; shift
    local item
    for item in "$@"; do out+="${sep}${item}"; done
    printf '%s' "$out"
}

# ---- chrome --------------------------------------------------------------
# gum style sizes a box to its longest line and does not wrap, so a summary
# naming a dozen updated steps rendered a ~160-column box that folded over
# itself and came out as broken border fragments. `--width` is the total
# rendered width, borders included, and makes lipgloss wrap inside it.
# tput needs a terminal; falling back to 80 is what keeps the box intact when
# the output is being captured rather than displayed.
# stty first, deliberately. `$(tput cols)` puts tput's stdout on a pipe, so it
# cannot query the terminal and quietly answers with terminfo's default of 80 —
# measured returning 80 in a 60-column pty, which is how the box stayed too wide
# the first time this was "fixed". `stty size </dev/tty` reads the real winsize.
box_width() {
    local c
    c=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)
    [[ "$c" =~ ^[0-9]+$ ]] || c=$(tput cols 2>/dev/null)
    [[ "$c" =~ ^[0-9]+$ ]] || c="${COLUMNS:-}"
    [[ "$c" =~ ^[0-9]+$ ]] || c=80
    ((c > 100)) && c=100
    ((c < 40)) && c=40
    printf '%s' "$c"
}

# Where this script really lives, following the stow symlink. `cd -P` on the
# dirname is NOT enough: stow links each file, so $0 is itself the symlink and
# the directory it sits in is ~/.local/bin, not the checkout. Resolve the file
# link, repeatedly, and only then take the directory.
self_dir() {
    local src=$0 dir
    while [[ -L "$src" ]]; do
        dir=$(cd -P "$(dirname "$src")" 2>/dev/null && pwd) || return 1
        src=$(readlink "$src")
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" 2>/dev/null && pwd
}

# The hardcoded version alone cannot tell a tagged release from four commits
# past it with local edits, which is exactly what a bug report needs. When the
# script resolves back into its checkout, git answers that precisely.
version() {
    local dir rev
    printf 'bump %s' "$BUMP_VERSION"
    dir=$(self_dir) || { printf '\n'; return 0; }
    if rev=$(git -C "$dir" describe --tags --always --dirty 2>/dev/null) && [[ -n "$rev" ]]; then
        printf ' (%s)' "$rev"
    fi
    printf '\n'
}

banner() {
    if $HAS_GUM && ! $VERBOSE; then
        local w; w=$(box_width)
        ((w > 48)) && w=48
        gum style --border double --border-foreground 212 \
            --foreground 213 --bold --align center \
            --padding "1 6" --margin "1 0" --width "$w" \
            "⚡  B U M P  ⚡" "" "let's get you up to date"
        printf '%s   %s · %s%s\n' "$D" "$(hostname -s)" "$(date '+%a %d %b %H:%M')" "$X"
    else
        printf '\n%s%s⚡ bump%s — %s · %s\n\n' "$B" "$P" "$X" "$(hostname -s)" "$(date '+%a %d %b %H:%M')"
    fi
}

# The slowest step is the only one worth knowing about, and a run that names a
# dozen updated managers in one comma-joined line buries it. Bars, sorted, turn
# "what happened" into "where the time went" — 11s of homebrew next to 1s of
# everything else — and they replace the updated-names line rather than adding
# to it, since each bar already carries its name.
duration_chart() {
    local width=$1 i max=0 barw secs label bar n fast=0
    ((${#DONE[@]} == 0)) && return 0
    for i in "${!DONE_SECS[@]}"; do ((DONE_SECS[i] > max)) && max=${DONE_SECS[i]}; done

    # Nothing took a measurable second: a column of empty bars reading "0s"
    # twelve times is worse than one line naming them, so fall back to that.
    if ((max < 1)); then
        printf '%supdated%s  %s\n' "$C" "$X" "$(join_with ', ' ${DONE[@]+"${DONE[@]}"})"
        return 0
    fi

    barw=$((width - 34))
    ((barw < 8)) && barw=8
    ((barw > 34)) && barw=34
    # `sort` rather than a bash sort: 3.2 has no associative arrays to sort by
    # value, and this has to run there.
    while IFS=$'\t' read -r secs label; do
        [[ -n "$label" ]] || continue
        # Sub-second steps are the boring majority; collapse them into a count
        # instead of spending a row each on a bar that rounds to nothing.
        if ((secs < 1)); then fast=$((fast + 1)); continue; fi
        n=$((secs * barw / max)); ((n < 1)) && n=1
        bar=$(printf '%*s' "$n" '' | tr ' ' '#')
        printf '%s%-18s%s %s%s%s %s%4ds%s\n' \
            "$C" "$label" "$X" "$G" "${bar//#/█}" "$X" "$D" "$secs" "$X"
    done < <(
        for i in "${!DONE[@]}"; do printf '%s\t%s\n' "${DONE_SECS[$i]}" "${DONE[$i]}"; done | sort -rn
    )
    ((fast > 0)) && printf '%s%-18s %s%s\n' "$D" "+$fast more" "under 1s" "$X"
    return 0
}

# Portable "how long since the last run": a marker file holding epoch seconds,
# because `date -d` (GNU) and `date -r` (BSD) disagree and the log directory
# names would have to be parsed back into a timestamp otherwise.
since_last_run() {
    local last now d
    last=$(cat "$LOG_ROOT/.last" 2>/dev/null)
    [[ "$last" =~ ^[0-9]+$ ]] || return 0
    now=$(date +%s); d=$((now - last))
    ((d < 0)) && return 0
    if   ((d < 90));    then printf 'just now'
    elif ((d < 5400));  then printf '%dm ago' $((d / 60))
    elif ((d < 172800)); then printf '%dh ago' $((d / 3600))
    else                     printf '%dd ago' $((d / 86400))
    fi
}

summary() {
    local elapsed=$1
    local sk fl counts
    # `${a[@]+"${a[@]}"}`, not a plain `"${a[@]}"`: macOS still ships bash 3.2 at
    # /bin/bash, where expanding an EMPTY array under `set -u` is an unbound
    # variable error. These three are the only expansions here that can be empty
    # (every other one is behind a count check), and on a fresh Mac — before
    # homebrew puts bash 5 on PATH — /bin/bash is exactly what runs this.
    sk=$(join_with ', ' ${SKIPPED[@]+"${SKIPPED[@]}"})
    fl=$(join_with ', ' ${FAILED[@]+"${FAILED[@]}"})
    counts=$(printf '✅ %d updated   💤 %d skipped   ❌ %d failed' \
        "${#DONE[@]}" "${#SKIPPED[@]}" "${#FAILED[@]}")

    # "all done" for a run where every step was skipped is how a PATH accident
    # reads as success. Say what actually happened instead.
    local head color=84 ago
    ago=$(since_last_run)
    [[ -n "$ago" ]] && ago="  ·  last run $ago"
    if ((${#FAILED[@]})); then
        head="💥  finished with errors  ·  ${elapsed}s${ago}"; color=203
    elif ((${#DONE[@]} == 0)); then
        head="🤷  nothing to do  ·  ${elapsed}s${ago}"; color=244
    else
        head="🎉  all done  ·  ${elapsed}s${ago}"
    fi

    # Only the lists that carry information: the chart names everything that
    # ran, so an "updated" line would repeat it, and empty skipped/failed lines
    # are three rows of em dashes saying nothing happened.
    local -a rows=("$head" "" "$counts")
    if ((${#DONE[@]})); then
        rows+=("")
        local l
        while IFS= read -r l; do rows+=("$l"); done < <(duration_chart "$(box_width)")
    fi
    ((${#SKIPPED[@]})) && rows+=("" "${D}skipped  $sk${X}")
    ((${#FAILED[@]}))  && rows+=("${R}failed   $fl${X}")

    if $HAS_GUM && ! $VERBOSE; then
        gum style --border rounded --border-foreground "$color" \
            --padding "1 3" --margin "1 0" --width "$(box_width)" "${rows[@]}"
    else
        printf '\n%s── %s ──%s\n' "$P" "$head" "$X"
        printf '%s\n' "${rows[@]:2}"
    fi
    printf '%s  · logs: %s%s\n' "$D" "$LOG_DIR" "$X"
}

# Keep the last 20 runs. Names are timestamps, so no spaces and no glob chars.
# A run where every step was skipped leaves an empty dir; drop it rather than
# spending one of the 20 slots on a run that recorded nothing.
prune_logs() {
    local d n=0
    # The version stamp is metadata about the run, not something the run
    # recorded, so a directory holding only that is still an empty run. Dropping
    # it first is what keeps `rmdir` able to see that.
    [[ -e "$LOG_DIR/.version" ]] && ! ls "$LOG_DIR"/*.log >/dev/null 2>&1 \
        && rm -f "$LOG_DIR/.version"
    rmdir "$LOG_DIR" 2>/dev/null
    while IFS= read -r d; do
        n=$((n + 1))
        ((n > 20)) && rm -rf "$d"
    done < <(ls -1dt "$LOG_ROOT"/*/ 2>/dev/null)   # trailing / == directories only
    return 0
}

# A dry run must not prompt for a password, so it never warms sudo and cannot
# know whether the grant would take. It marks the root-hungry steps with 🔐
# instead of guessing.
dry_run() {
    local i name note
    printf '%s  plan (%d steps) — nothing will run%s\n\n' "$D" "${#SEL_NAME[@]}" "$X"
    for i in "${!SEL_NAME[@]}"; do
        name="${SEL_NAME[$i]}"
        note="${SEL_PHASE[$i]}"
        [[ "${SEL_SUDO[$i]}" == yes ]] && note="$note, sudo 🔐"
        SKIP_REASON="not applicable"
        if "g_${name//-/_}"; then
            printf '%s  ✓%s %s %-22s %s%s · %s%s\n' "$G" "$X" "${SEL_EMOJI[$i]}" \
                "${SEL_LABEL[$i]}" "$D" "$note" "$name" "$X"
        else
            printf '%s  ·  %s %-22s skipped (%s)%s\n' "$D" "${SEL_EMOJI[$i]}" \
                "${SEL_LABEL[$i]}" "$SKIP_REASON" "$X"
        fi
    done
}

# ---- main ----------------------------------------------------------------
need_arg() { [[ -n "${2:-}" ]] || { printf '%s%s needs a value%s\n' "$R" "$1" "$X" >&2; exit 2; }; }

while (($#)); do
    case "$1" in
        -h|--help)
            # Print the contiguous comment block (skip the shebang, stop at the
            # first non-comment line), stripping the leading "# ".
            awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
            exit 0 ;;
        -l|--list)     all_names; exit 0 ;;
        -V|--version)  version; exit 0 ;;
        -v|--verbose)  VERBOSE=true; shift ;;
        -n|--dry-run)  DRY_RUN=true; shift ;;
        --only)        need_arg "$1" "${2:-}"; ONLY="$2"; shift 2 ;;
        # `--only=` with nothing after it used to leave ONLY empty, which reads
        # as "no filter" and quietly ran the whole thing. Treat it as missing.
        --only=*)      need_arg --only "${1#*=}"; ONLY="${1#*=}"; shift ;;
        --skip)        need_arg "$1" "${2:-}"; SKIP="$2"; shift 2 ;;
        --skip=*)      need_arg --skip "${1#*=}"; SKIP="${1#*=}"; shift ;;
        *) printf '%sunknown argument: %s%s\ntry: bump --help\n' "$R" "$1" "$X" >&2; exit 2 ;;
    esac
done

[[ -n "$ONLY" ]] && validate_names --only "$ONLY"
[[ -n "$SKIP" ]] && validate_names --skip "$SKIP"
build_plan
TAG_W=$(( ${#SEL_NAME[@]} > 9 ? 7 : 5 ))   # width of "[12/12]" vs "[9/9]"
((${#SEL_NAME[@]} == 0)) && { printf '%sno steps selected%s\n' "$R" "$X" >&2; exit 2; }

banner

# Say so out loud rather than degrading quietly: a run with no watchdog is
# exactly the run that can burn an hour behind the spinner.
if ((BUMP_TIMEOUT > 0)) && [[ -z "$TIMEOUT_BIN" ]]; then
    printf '%s  ⚠️  no timeout(1)/gtimeout from coreutils — steps run unbounded this time.%s\n' "$R" "$X"
fi

# Prompt once, up front, instead of mid-run. If this fails (wrong password, no
# sudo rights), DON'T plough ahead into the steps that need root: every sudo
# inside a step can run under `gum spin`, which hides stdout/stderr, so a second
# prompt would be invisible and the run would hang on it forever (the "3156s"
# hang). Record the failure and let the sudo:yes steps skip cleanly while the
# rest still run. Steps that don't need root never trigger the prompt at all.
MAIN_PID=$$
cleanup_sudo() { [[ -n "${SUDO_KEEPALIVE_PID:-}" ]] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null; }
SUDO_KEEPALIVE_PID=
if $SUDO_NEEDED && ! $DRY_RUN; then
    declare -a sudo_labels=()
    for i in "${!SEL_NAME[@]}"; do
        [[ "${SEL_SUDO[$i]}" == yes ]] && sudo_labels+=("${SEL_LABEL[$i]}")
    done
    # Three outcomes, kept apart because they need different things from the
    # reader. Already-warm needs nothing and should not print a prompt line at
    # all. No controlling terminal is not a refusal — it is bump running under
    # something that captured its output (a CI step, an agent's shell), where
    # sudo's own message is "a terminal is required to read the password" and
    # calling that "not authorized" sends the reader off to check sudoers.
    # Only the third case is an actual refusal.
    if sudo -n -v 2>/dev/null; then
        :
    elif ! { : </dev/tty; } 2>/dev/null; then
        SUDO_OK=false
        printf '%s  ⚠️  no terminal to ask for a password on — skipping: %s%s\n' \
            "$R" "$(join_with ', ' "${sudo_labels[@]}")" "$X"
    else
        printf '%s  🔐 warming sudo (needed for: %s)…%s\n' \
            "$D" "$(join_with ', ' "${sudo_labels[@]}")" "$X"
        if ! sudo -v; then
            SUDO_OK=false
            printf '%s  ⚠️  sudo not authorized — skipping the steps that need root.%s\n' "$R" "$X"
        fi
    fi
fi

# Warming it once is not enough: macOS's sudo timestamp lapses after ~5 minutes,
# and the steps that need root land much later than that — `brew upgrade --cask`
# reached multipass (a Pkg cask, so `sudo launchctl`/`pkgutil`) ~25 minutes in.
# sudo writes that prompt straight to /dev/tty, which the gum spinner is busy
# repainting, so it is invisible in practice and the run just sits on it until
# the watchdog kills the step. Refreshing in the background keeps every later
# sudo non-interactive.
#
# `sudo -n -v` so the refresher itself can never become the thing that prompts:
# if the grant is revoked mid-run it exits, and the step's own sudo then fails
# loudly rather than blocking. The `kill -0 $MAIN_PID` makes it self-terminate
# within a minute even if the trap below never runs (SIGKILL, crash), and the
# sleep runs as a tracked child so the TERM trap can take it down with the loop
# instead of leaving a stray `sleep 60` behind after the run ends.
if $SUDO_NEEDED && ! $DRY_RUN && [[ "$SUDO_OK" == true ]]; then
    (
        sleeper=
        trap 'kill "$sleeper" 2>/dev/null; exit 0' TERM
        while sudo -n -v 2>/dev/null; do
            sleep 60 & sleeper=$!
            wait "$sleeper" 2>/dev/null
            kill -0 "$MAIN_PID" 2>/dev/null || exit 0
        done
    ) &
    SUDO_KEEPALIVE_PID=$!
    trap cleanup_sudo EXIT
    trap 'cleanup_sudo; exit 130' INT TERM
fi

if $DRY_RUN; then
    echo
    dry_run
    exit 0
fi

# Started here, not before the sudo prompt: the elapsed time is meant to measure
# the run, and starting it earlier folded in however long the human took to type
# a password — time that then appeared in the total while belonging to no bar in
# the chart below it.
start=$SECONDS

mkdir -p "$LOG_DIR" || { printf '%scannot create log dir %s%s\n' "$R" "$LOG_DIR" "$X" >&2; exit 2; }
version >"$LOG_DIR/.version" 2>/dev/null   # so a kept log says which build wrote it
echo

# Serial phase first (ordered, root-hungry), then the independent managers.
# --verbose forces everything serial: concurrent live output is unreadable.
declare -a PAR_IDX=()
for i in "${!SEL_NAME[@]}"; do
    if [[ "${SEL_PHASE[$i]}" == par ]] && ! $VERBOSE; then
        PAR_IDX+=("$i"); continue
    fi
    check_step "$((i + 1))" "${SEL_NAME[$i]}" "${SEL_EMOJI[$i]}" "${SEL_LABEL[$i]}" "${SEL_SUDO[$i]}" \
        && run_serial "$((i + 1))" "${SEL_NAME[$i]}" "${SEL_EMOJI[$i]}" "${SEL_LABEL[$i]}" "${SEL_SPIN[$i]}"
done
((${#PAR_IDX[@]})) && run_parallel

summary $((SECONDS - start))
date +%s >"$LOG_ROOT/.last" 2>/dev/null
prune_logs
# Once more at the end: the per-spinner drain above is the fix, this is the
# guard against a future gum learning to probe from somewhere else. Whatever it
# discards is type-ahead typed at an unattended updater, which is no loss.
drain_tty
((${#FAILED[@]} == 0))
